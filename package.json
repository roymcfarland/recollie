{
  "name": "recollie",
  "version": "3.0.0",
  "description": "A tiny Node.js client for searching public recall APIs.",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "npm test && npm run pack:check",
    "prepublishOnly": "npm run check",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roymcfarland/recollie.git"
  },
  "keywords": [
    "recall",
    "recalls",
    "cpsc",
    "openfda",
    "consumer",
    "safety",
    "protection"
  ],
  "author": "Roy McFarland",
  "contributors": [
    "Max Richman",
    "Antonio Bermudez",
    "Chris Rolfs"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/roymcfarland/recollie/issues"
  },
  "homepage": "https://github.com/roymcfarland/recollie#readme"
}
